# REST API URL used by the Vite frontend during local development.
VITE_API_BASE_URL=http://localhost:8081/api
JWT_SECRET=replace-with-a-private-random-secret-of-at-least-32-bytes

# Docker Compose sets VITE_API_BASE_URL while building the frontend image.
# The browser served by Docker Compose uses http://localhost:3000.
